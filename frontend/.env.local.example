# EngineerAI frontend — environment configuration
# Copy this file to .env.local (git-ignored) and adjust if needed.

# The NEXT_PUBLIC_ prefix is required — without it, Next.js only exposes
# this variable to server-side code, not to code running in the browser,
# and the API client needs it in the browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

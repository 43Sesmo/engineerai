# EngineerAI backend — environment configuration
# Copy this file to `.env` and adjust as needed. `.env` is git-ignored.

# --- Database ---------------------------------------------------------
# Temporary local development database (SQLite). This is the ONLY line
# that needs to change when migrating to PostgreSQL later, e.g.:
#   DATABASE_URL=postgresql://user:password@localhost:5432/engineerai
DATABASE_URL=sqlite:///./engineerai.db

# --- AI Layer -----------------------------------------------------------
# Unused until Task 7 (AI Layer: Claude Client Wrapper). Safe to leave
# blank for now.
CLAUDE_API_KEY=

# --- Server ---------------------------------------------------------------
SERVER_PORT=8000

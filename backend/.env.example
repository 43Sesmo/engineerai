# EngineerAI backend — environment configuration
# Copy this file to `.env` and adjust as needed. `.env` is git-ignored.

# --- Database ---------------------------------------------------------
# Temporary local development database (SQLite). This is the ONLY line
# that needs to change when migrating to PostgreSQL later, e.g.:
#   DATABASE_URL=postgresql://user:password@localhost:5432/engineerai
DATABASE_URL=sqlite:///./engineerai.db

# --- AI Provider -----------------------------------------------------
# Select which provider send_prompt() uses: "anthropic" or "openai".
AI_PROVIDER=anthropic

# Anthropic credentials. ANTHROPIC_API_KEY is the current name;
# CLAUDE_API_KEY is still honored for backward compatibility if you have
# an existing .env using the old name.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI credentials — only needed if AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# --- Server ---------------------------------------------------------------
SERVER_PORT=8000
